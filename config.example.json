{
  "schema_version": 2,
  "timezone": "Asia/Shanghai",
  "daily_digest_time": "09:00",
  "daily_quota_default": 5,
  "daily_quota_max": 20,
  "min_match_score_default": 70,
  "decision_after_hours": 24,
  "application_followup_days_default": 3,
  "source_policy": {
    "official_first": true,
    "aggregator_mode": "low_frequency",
    "official_tiers": ["A", "B"],
    "recommendation_tiers": ["A", "B"],
    "unverified_tier": "C"
  },
  "privacy": {
    "store_routine_profile_fields": true,
    "store_passwords": false,
    "store_captcha_or_sms": false,
    "store_id_numbers": false,
    "redact_logs": true
  },
  "resume": {
    "campus_pages": 1,
    "social_pages_max": 2,
    "require_photo_for_cn": true
  }
}
